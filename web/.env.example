# Server runtime configuration. Locally: copy to .env (git-ignored) — both
# `npm run dev` and `npm start` read it. In ECS: set these on the task
# definition, with SYNAPSE_CLIENT_SECRET as a Secrets Manager secret.
# Nothing here is baked into the build; the browser gets the public values
# from /config.js and never sees the secret.

# Required. Sage Brain API base URL — the unified API (serves both /ask and /query),
# stage prefix included, no trailing slash. It is the API base URL output of the
# app-{env}-api stack in sagebrain-infra, e.g.
#   aws --profile sagebrain cloudformation describe-stacks --stack-name app-<env>-api \
#     --query "Stacks[0].Outputs" --output table
API_BASE_URL=

# Synapse OAuth client — register at https://www.synapse.org/#!OAuthClientManagement:
# Add SYNAPSE_REDIRECT_URI to the client exactly (trailing slash included).
SYNAPSE_CLIENT_ID=
SYNAPSE_REDIRECT_URI=http://localhost:5173/
SYNAPSE_CLIENT_SECRET=

# Optional. Default "openid": the API authorizer resolves the user via OIDC
# userinfo (the "userid" claim) and checks Sage Brain team membership.
# SYNAPSE_SCOPE=openid

# Optional, production server only (default 8080).
# PORT=8080
